# Copy to .env; never commit keys or personal photos.
GENERATION_MODE=seedream
PORT=4377
# The booth generates one portrait; captured originals are free.
# IMAGE_COUNT is no longer used by the kiosk.
SEEDREAM_API_KEY=
# Obtain the currently available image-editing model ID from your Ark account.
SEEDREAM_MODEL=
# Optional explicit address accessible to phones, e.g. http://192.168.1.20:4377
PICKUP_BASE_URL=
# Payment remains simulated; no customer is charged.
# Production launch reuses PORT and data/. Do not set BOOTH_FRESH_INSTANCE=1.
